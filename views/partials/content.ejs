<div class="balance">
    <h2>Баланс: <span id="balance"><%= balance %> руб.</span></h2>
  </div>
  
  <div class="actions">
    <form action="/deposit" method="POST">
      <h3>Пополнить кошелёк</h3>
      <input type="number" name="amount" placeholder="Сумма" min="0.01" step="0.01" required />
      <button type="submit">Пополнить</button>
    </form>
  
    <form action="/pay" method="POST">
      <h3>Оплатить покупку</h3>
      <input type="number" name="amount" placeholder="Сумма" min="0.01" step="0.01" required />
      <input type="text" name="description" placeholder="Описание покупки" required />
      <button type="submit">Оплатить</button>
    </form>
  
    <form action="/transfer" method="POST">
      <h3>Перевести деньги</h3>
      <input type="text" name="to_user" placeholder="Имя получателя" required />
      <input type="number" name="amount" placeholder="Сумма" min="0.01" step="0.01" required />
      <button type="submit">Перевести</button>
    </form>
  </div>
  
  <div class="transactions">
    <h2>История операций</h2>
    <% if (transactions.length === 0) { %>
      <p>Нет операций</p>
    <% } else { %>
      <ul>
        <% transactions.forEach(t => { %>
          <li>
            <strong><%= t.type === 'deposit' ? 'Пополнение' : t.type === 'payment' ? 'Покупка' : 'Перевод' %></strong>
            <% if (t.from_user) { %> от <%= t.from_user %> <% } %>
            <% if (t.to_user && t.to_user !== user) { %> → <%= t.to_user %> <% } %>
            на <%= t.amount %> руб.
            <% if (t.description) { %> (<%= t.description %>) <% } %>
            <br><small><%= new Date(t.timestamp).toLocaleString() %></small>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>